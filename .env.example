# Copy to .env if overriding defaults. Never commit .env.
PRAESIDIONYX_PLATFORM=linux/arm64
PRAESIDIONYX_BUILD_PROFILE=quickstart
# Optional build-only workaround for Docker Desktop bridge download stalls:
# PRAESIDIONYX_BUILD_NETWORK=host
PRAESIDIONYX_PROVIDER=mock
PRAESIDIONYX_AGENT_PORT=18080
PRAESIDIONYX_SUPERVISOR_PORT=18081
PRAESIDIONYX_LOG=info
# Optional providers: set PRAESIDIONYX_PROVIDER and PRAESIDIONYX_MODEL together.
# PRAESIDIONYX_MODEL=llama3.2
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# Anthropic also requires explicit conservative rates for that pinned model.
# ANTHROPIC_API_KEY=
# PRAESIDIONYX_MODEL=your-anthropic-model-id
# PRAESIDIONYX_INPUT_MICROUSD_PER_TOKEN=3
# PRAESIDIONYX_OUTPUT_MICROUSD_PER_TOKEN=15
# Rates are examples, not a current pricing recommendation; use your contract.
